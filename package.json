{
  "name": "finance-agent-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @finance/server dev",
    "dev:desktop": "pnpm --filter @finance/dashboard dev",
    "desktop:dev": "pnpm -r --parallel dev",
    "desktop:electron": "pnpm --filter @finance/dashboard electron:dev",
    "desktop:build": "pnpm --filter @finance/dashboard build",
    "desktop:start": "pnpm --filter @finance/dashboard electron:start",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @finance/shared build",
    "build:core": "pnpm --filter @finance/core build",
    "build:server": "pnpm --filter @finance/server build",
    "start": "pnpm --filter @finance/server start",
    "openbot": "node scripts/openbot.js",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@9.0.0"
}
