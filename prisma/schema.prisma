// Finance Agent OS — Prisma Schema (Slim — no hang)
// Keeps only transactional tables. Hot path (Event/AuditLog/MarketCandle/PortfolioSnapshot)
// moved to in-memory + JSONL files to avoid SQLite WAL lock.
// Run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Accounts (core identity)
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  name      String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String   @default("spot")
  currency  String   @default("USDT")
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  positions Position[]
  trades    Trade[]
}

// ---------------------------------------------------------------------------
// Strategies
// ---------------------------------------------------------------------------

model Strategy {
  id          String   @id @default(uuid())
  name        String
  version     String   @default("1.0.0")
  description String?
  enabled     Boolean  @default(true)
  timeframe   String   @default("1m")
  parameters  String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signals Signal[]
  trades  Trade[]
}

// ---------------------------------------------------------------------------
// Signals (quant output — low frequency)
// ---------------------------------------------------------------------------

model Signal {
  id         String   @id @default(uuid())
  strategyId String?
  symbol     String
  side       String
  price      Float
  confidence Float
  timeframe  String   @default("tick")
  reasoning  String?
  indicators String   @default("{}")
  createdAt  DateTime @default(now())

  strategy Strategy? @relation(fields: [strategyId], references: [id])

  @@index([symbol, createdAt])
}

// ---------------------------------------------------------------------------
// Risk Decisions
// ---------------------------------------------------------------------------

model RiskDecision {
  id                String   @id @default(uuid())
  correlationId     String?
  decision          String
  reason            String
  rulesChecked      String   @default("[]")
  requestedQuantity Float
  approvedQuantity  Float
  riskMetrics       String   @default("{}")
  signalId          String?
  createdAt         DateTime @default(now())

  @@index([correlationId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Orders (+ fills)
// ---------------------------------------------------------------------------

model Order {
  id               String   @id @default(uuid())
  clientOrderId    String   @default(uuid())
  symbol           String
  side             String
  type             String   @default("market")
  quantity         Float
  price            Float
  stopPrice        Float?
  status           String   @default("CREATED")
  strategyId       String?
  agentId          String?
  executionMode    String   @default("paper")
  filledQuantity   Float    @default(0)
  averageFillPrice Float    @default(0)
  fees             Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  submittedAt      DateTime?
  filledAt         DateTime?
  cancelledAt      DateTime?

  fills OrderFill[]

  @@index([status])
  @@index([symbol, createdAt])
}

model OrderFill {
  id        String   @id @default(uuid())
  orderId   String
  symbol    String
  side      String
  quantity  Float
  price     Float
  fee       Float    @default(0)
  timestamp DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Positions
// ---------------------------------------------------------------------------

model Position {
  id            String    @id @default(uuid())
  accountId     String
  symbol        String
  side          String    @default("long")
  quantity      Float
  entryPrice    Float
  markPrice     Float     @default(0)
  unrealizedPnl Float     @default(0)
  realizedPnl   Float     @default(0)
  leverage      Float     @default(1)
  stopLoss      Float?
  takeProfit    Float?
  status        String    @default("open")
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  updatedAt     DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, status])
  @@index([symbol, status])
}

// ---------------------------------------------------------------------------
// Trades
// ---------------------------------------------------------------------------

model Trade {
  id         String    @id @default(uuid())
  accountId  String?
  strategyId String?
  symbol     String
  side       String
  entryPrice Float
  exitPrice  Float?
  quantity   Float
  fees       Float     @default(0)
  pnl        Float     @default(0)
  status     String    @default("open")
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  account  Account?  @relation(fields: [accountId], references: [id])
  strategy Strategy? @relation(fields: [strategyId], references: [id])

  @@index([status])
  @@index([symbol, openedAt])
}
