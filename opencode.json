{
    "$schema":  "https://opencode.ai/config.json",
    "model":  "opencode/space-bunny-free",
    "small_model":  "opencode/mimo-v2.6-flash-free",
    "agent":  {
                  "hermes":  {
                                 "description":  "Hermes - senior autonomous finance engineering and trading-agent analyst",
                                 "mode":  "primary",
                                 "model":  "opencode/space-bunny-free",
                                 "small_model":  "opencode/mimo-v2.6-flash-free",
                                 "temperature":  0.2,
                                 "prompt":  "You are Hermes, the senior finance engineering and quantitative analysis agent for this project.\n\nYour responsibilities:\n- Analyze market data, indicators, backtests, portfolio state, risk metrics, and execution behavior.\n- Design, review, and improve trading strategies without look-ahead bias.\n- Explain assumptions, formulas, edge cases, and confidence levels clearly.\n- Treat all trading as paper trading by default. Never bypass risk limits, kill switches, approval tickets, or execution safeguards.\n- Treat secrets, API keys, credentials, and private data as sensitive; never print or commit them.\n- For code changes, inspect existing conventions, make focused edits, and run relevant checks.\n- Clearly distinguish facts, assumptions, hypotheses, and recommendations.",
                                 "permission":  {
                                                    "edit":  "allow",
                                                    "bash":  "allow",
                                                    "webfetch":  "allow"
                                                },
                                 "color":  "#4F8CFF"
                             },
                  "btc-quant-agent":  {
                                          "description":  "Finance Agent OS btc-quant-agent",
                                          "mode":  "primary",
                                          "model":  "opencode/space-bunny-free",
                                          "small_model":  "opencode/mimo-v2.6-flash-free",
                                          "prompt":  "You are the btc-quant-agent Finance Agent OS agent. Follow the quant role strictly, use only the tools available to you, and never bypass paper-trading and risk safeguards.",
                                          "permission":  {
                                                             "edit":  "allow",
                                                             "bash":  "allow",
                                                             "webfetch":  "allow"
                                                         }
                                      },
                  "risk-guardian-agent":  {
                                              "description":  "Finance Agent OS risk-guardian-agent",
                                              "mode":  "primary",
                                              "model":  "opencode/space-bunny-free",
                                              "small_model":  "opencode/mimo-v2.6-flash-free",
                                              "prompt":  "You are the risk-guardian-agent Finance Agent OS agent. Follow the risk role strictly, use only the tools available to you, and never bypass paper-trading and risk safeguards.",
                                              "permission":  {
                                                                 "edit":  "allow",
                                                                 "bash":  "allow",
                                                                 "webfetch":  "allow"
                                                             }
                                          },
                  "opencode-cli-agent":  {
                                             "description":  "Finance Agent OS opencode-cli-agent",
                                             "mode":  "primary",
                                             "model":  "opencode/space-bunny-free",
                                             "small_model":  "opencode/mimo-v2.6-flash-free",
                                             "prompt":  "You are the opencode-cli-agent Finance Agent OS agent. Follow the cli role strictly, use only the tools available to you, and never bypass paper-trading and risk safeguards.",
                                             "permission":  {
                                                                "edit":  "allow",
                                                                "bash":  "allow",
                                                                "webfetch":  "allow"
                                                            }
                                         },
                  "market-research-agent":  {
                                                "description":  "Finance Agent OS market-research-agent",
                                                "mode":  "primary",
                                                "model":  "opencode/space-bunny-free",
                                                "small_model":  "opencode/mimo-v2.6-flash-free",
                                                "prompt":  "You are the market-research-agent Finance Agent OS agent. Follow the market role strictly, use only the tools available to you, and never bypass paper-trading and risk safeguards.",
                                                "permission":  {
                                                                   "edit":  "allow",
                                                                   "bash":  "allow",
                                                                   "webfetch":  "allow"
                                                               }
                                            }
              }
}
